# ─── Site ────────────────────────────────────────────────────────────────
# Canonical production URL used for canonical tags, sitemap and Open Graph URLs
NEXT_PUBLIC_SITE_URL=https://astratech.com.np
# Show draft content (TODO placeholders) outside development, e.g. on a preview deployment
NEXT_PUBLIC_SHOW_DRAFTS=false

# ─── Map ────────────────────────────────────────────────────────────────
# Exact office location: coordinates ("26.6646,87.2718") or a Google Maps place name.
# Leave empty to show a city-level pin for Itahari, Sunsari (until the exact pin is known).
NEXT_PUBLIC_OFFICE_MAP_QUERY=
# Optional: Google Maps Embed API key (restrict it to your domain in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ─── Forms (Resend) ─────────────────────────────────────────────────────
# Server-side only. Contact, quote, careers (with CV) and newsletter forms are emailed via Resend.
RESEND_API_KEY=
# Where submissions are sent (defaults to contact@astratech.com.np)
FORM_TO_EMAIL=
# Verified sender in Resend, e.g. "Astra Website <website@astratech.com.np>"
FORM_FROM_EMAIL=
# Optional: add newsletter sign-ups to this Resend audience instead of emailing them
RESEND_AUDIENCE_ID=

# ─── Booking ────────────────────────────────────────────────────────────
# Calendly scheduling link, e.g. https://calendly.com/astratech/free-consultation
NEXT_PUBLIC_CALENDLY_URL=

# ─── Analytics & search engines ─────────────────────────────────────────
# Google Analytics 4 measurement ID (shows a cookie consent banner)
NEXT_PUBLIC_GA_ID=
# Plausible (cookieless, no banner needed) — your site domain, e.g. astratech.com.np
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Search Console / Bing Webmaster verification codes (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Google Business Profile page and "write a review" link
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ─── Error monitoring (Sentry) ──────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces (source map upload at build time)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
